#!/usr/bin/env just --justfile

# How to call the current just executable. Note that just_executable() may have `\` in Windows paths, so we need to quote it.
just := quote(just_executable())

# Run all benchmarks (Rust only)
all:
    cargo bench --bench fastpfor_benchmark --no-default-features --features rust

# Run all benchmarks with C++ comparison enabled using portable SIMD
all-with-cpp-portable: (_all-with-cpp 'portable')

# Run all benchmarks with C++ comparison enabled using native SIMD
all-with-cpp-native: (_all-with-cpp 'native')

_all-with-cpp mode:
    cargo bench --bench fastpfor_benchmark --features cpp_{{mode}},rust

# Benchmark compression speed across data patterns
compression:
    cargo bench --bench fastpfor_benchmark --features rust -- compression

# Benchmark decompression speed across data patterns
decompression:
    cargo bench --bench fastpfor_benchmark --features rust -- decompression

# Benchmark full compress+decompress roundtrip
roundtrip:
    cargo bench --bench fastpfor_benchmark --features rust -- roundtrip

# Benchmark BLOCK_SIZE_128 vs BLOCK_SIZE_256
block-sizes:
    cargo bench --bench fastpfor_benchmark --features rust -- block_sizes

# Benchmark compression ratio across data patterns
compression-ratio:
    cargo bench --bench fastpfor_benchmark --features rust -- compression_ratio

# Benchmark C++ FastPFor128 vs pure-Rust FastPFOR
cpp-vs-rust mode='portable':
    cargo bench --bench fastpfor_benchmark --features rust,cpp_{{mode}} -- cpp_vs_rust

# Benchmark C++ vs Rust encoding speed only
cpp-vs-rust-encode mode='portable':
    cargo bench --bench fastpfor_benchmark --features rust,cpp_{{mode}} -- "cpp_vs_rust/encode"

# Benchmark C++ vs Rust decoding speed only
cpp-vs-rust-decode mode='portable':
    cargo bench --bench fastpfor_benchmark --features rust,cpp_{{mode}} -- "cpp_vs_rust/decode"

# Benchmark scalar vs SIMD kernels (byte-identical output)
kernels *args:
    cargo bench --bench fastpfor_benchmark --features rust -- kernels/ {{args}}

# Compares C++ vs Rust, portable vs SIMD kernels, sequential vs interleaved wire format, u32/u64, 128/256 blocks.
# Extra args: `--save <file>` keeps the raw counts, `--baseline <file>` compares with saved ones.
# Count CPU instructions per value (valgrind/callgrind) of every FastPFor implementation
instructions mode='native' *args:
    cargo bench --bench instructions --features rust,simd,cpp_{{mode}} -- {{args}}

# Needs `kernel.perf_event_paranoid <= 2`; set `cpu=''` to not pin the runs to one CPU.
# Like `instructions`, but counts instructions and cycles with the CPU's hardware counters (`perf stat`)
perf mode='native' cpu='2' *args: perf-check
    FASTPFOR_BENCH_CPU='{{cpu}}' cargo bench --bench instructions --features rust,simd,cpp_{{mode}} -- --perf {{args}}

# Check that `perf` can read the CPU's instruction and cycle counters, and explain how to allow it if not
perf-check:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v perf >/dev/null; then
        echo "error: 'perf' is not installed. On Debian/Ubuntu: sudo apt install linux-tools-common linux-tools-\$(uname -r)" >&2
        exit 1
    fi
    paranoid="$(cat /proc/sys/kernel/perf_event_paranoid)"
    if [ "$paranoid" -gt 2 ]; then
        echo "error: the kernel does not let unprivileged processes read CPU counters (kernel.perf_event_paranoid = $paranoid, needs 2 or lower)." >&2
        echo "Allow it until the next reboot:" >&2
        echo "    sudo sysctl kernel.perf_event_paranoid=2" >&2
        echo "or permanently:" >&2
        echo "    echo 'kernel.perf_event_paranoid = 2' | sudo tee /etc/sysctl.d/60-perf.conf && sudo sysctl --system" >&2
        echo "Level 2 only allows measuring user-space code of your own processes." >&2
        echo "Alternatively, run 'just bench instructions', which uses valgrind and needs no kernel changes." >&2
        exit 1
    fi
    if ! probe="$(perf stat -x, -e instructions:u,cycles:u -- true 2>&1)" || [[ "$probe" == *"<not supported>"* ]]; then
        echo "error: perf cannot read the CPU's instruction and cycle counters (in a VM, the hypervisor may not expose them):" >&2
        echo "$probe" >&2
        exit 1
    fi

# Counts cycles too if `perf` can read the CPU counters. With `base_ref`, also counts that commit and shows the changes.
# Count instructions of all FastPFor implementations into a Markdown report, as expected by CI
ci output='target/bench/summary.md' base_ref='':
    #!/usr/bin/env bash
    set -euo pipefail
    # Paths are relative to the repository root, like the CI job's.
    cd {{quote(justfile_directory())}}
    if ! command -v valgrind > /dev/null; then
        echo "error: 'valgrind' is not installed" >&2
        exit 1
    fi
    out_dir="$(realpath -m "$(dirname {{quote(output)}})")"
    mkdir -p "$out_dir"
    rm -f "$out_dir"/base-*.tsv
    perf=0
    if {{just}} bench perf-check 2> "$out_dir/perf.log"; then perf=1; else cat "$out_dir/perf.log" >&2; fi

    base_note=""
    if [ -n {{quote(base_ref)}} ]; then
        # Count the base commit with this commit's benchmark, so that both use the same workload and
        # measurement. Its worktree is outside this one, so cargo does not see two nested packages.
        base_src="$(mktemp -d)/base"
        trap 'git worktree remove --force "$base_src" 2>/dev/null || true' EXIT
        git worktree add --quiet --detach "$base_src" {{quote(base_ref)}}
        git -C "$base_src" submodule update --quiet --init --recursive --depth 1
        cp benches/instructions.rs "$base_src/benches/instructions.rs"
        if ! grep -q '^name = "instructions"' "$base_src/Cargo.toml"; then
            printf '\n[[bench]]\nname = "instructions"\nrequired-features = ["rust"]\nharness = false\n' >> "$base_src/Cargo.toml"
        fi
        features="rust,cpp_portable"
        if grep -q '^simd = ' "$base_src/Cargo.toml"; then features="$features,simd"; fi
        base_bench() {
            (cd "$base_src" && cargo bench --bench instructions --features "$features" -- "$@") > /dev/null 2>> "$out_dir/base.log"
        }
        : > "$out_dir/base.log"
        if base_bench --save "$out_dir/base-callgrind.tsv"; then
            if [ "$perf" = 1 ]; then
                FASTPFOR_BENCH_CPU=2 base_bench --perf --save "$out_dir/base-perf.tsv" || rm -f "$out_dir/base-perf.tsv"
            fi
            base_note="Compared with the base commit $(git rev-parse --short {{quote(base_ref)}}), counted with this commit's benchmark."
        else
            base_note="The base commit $(git rev-parse --short {{quote(base_ref)}}) could not be counted with this commit's benchmark (e.g. the public API changed); see the job log."
            echo "::warning::Could not benchmark the base commit:" >&2
            tail -n 30 "$out_dir/base.log" >&2
        fi
    fi
    baseline() { if [ -f "$out_dir/base-$1.tsv" ]; then echo "--baseline $out_dir/base-$1.tsv"; fi; }

    {{just}} bench instructions portable $(baseline callgrind) > "$out_dir/callgrind.md"
    if [ "$perf" = 1 ] && {{just}} bench perf portable 2 $(baseline perf) > "$out_dir/perf.md" 2>> "$out_dir/perf.log"; then
        perf_section="$(cat "$out_dir/perf.md")"
    else
        perf_section="Not available on this machine: $(grep -m1 '^error' "$out_dir/perf.log" || tail -n1 "$out_dir/perf.log")"
    fi
    {
        echo "## FastPFor instruction counts"
        echo
        echo "Commit $(git rev-parse --short HEAD), $(lscpu | sed -n 's/^Model name: *//p'), C++ built in portable mode."
        echo "Counted with valgrind's callgrind, so the counts are exact and repeat on any CPU with the same features."
        if [ -n "$base_note" ]; then echo "$base_note"; fi
        cat "$out_dir/callgrind.md"
        echo
        echo "<details><summary>Hardware counters (<code>perf stat</code>): instructions and cycles</summary>"
        echo
        echo "$perf_section"
        echo
        echo "</details>"
    } > {{quote(output)}}
    cat {{quote(output)}} >> "${GITHUB_STEP_SUMMARY:-/dev/stdout}"
